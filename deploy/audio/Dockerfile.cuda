FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 MPLCONFIGDIR=/tmp/matplotlib OMP_NUM_THREADS=2 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    BENTEBOT_AUDIO_DEVICE=cuda \
    CUDA_CACHE_PATH=/tmp/cuda-cache XDG_CACHE_HOME=/tmp/cache \
    LD_LIBRARY_PATH=/usr/local/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/site-packages/nvidia/cufft/lib:/usr/local/lib/python3.12/site-packages/nvidia/curand/lib:/usr/local/lib/python3.12/site-packages/nvidia/nvjitlink/lib
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgl1 libegl1 libgles2 libportaudio2 libgomp1 zlib1g ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --no-log-init --uid 99 --gid 100 --no-create-home awareness
COPY deploy/audio/requirements.txt deploy/audio/requirements.cuda.txt ./
# Piper depends on CPU ORT. Replace its shared module files with the CUDA build
# after all Piper dependencies are installed; never leave both ORT binaries installed.
RUN pip install --no-cache-dir -r requirements.txt \
    && pip uninstall -y onnxruntime \
    && pip install --no-cache-dir -r requirements.cuda.txt \
    && python -c "import onnxruntime as o; assert 'CUDAExecutionProvider' in o.get_available_providers()"
RUN python -c "from mediapipe.tasks.python.core.mediapipe_c_bindings import load_raw_library; load_raw_library()"
COPY bentebot_audio_worker/ ./bentebot_audio_worker/
USER 99:100
EXPOSE 18769
HEALTHCHECK --interval=20s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import json,urllib.request; h=json.load(urllib.request.urlopen('http://127.0.0.1:18769/health', timeout=3)); assert h['device']=='cuda'"
CMD ["python", "-m", "bentebot_audio_worker"]
