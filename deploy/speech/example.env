# These settings belong to the OPTIONAL SEPARATE speech stack, not Bentebot's .env.
SPEECH_BIND_IP=127.0.0.1
# Replace with the server's private LAN address when Bentebot runs in another container.
STT_PORT=8765
TTS_PORT=8766
STT_MODEL=base
STT_LANGUAGE=auto
STT_CHUNK_SECONDS=0.5
STT_BEAM_SIZE=1
STT_COMPUTE_TYPE=int8
STT_CUDA_COMPUTE_TYPE=int8_float32
SPEECH_CPU_THREADS=4
KITTEN_PORT=8767
# Edit KITTENML_VLLM_OPTIONS in compose.kitten.yaml to change its GPU memory cap.
