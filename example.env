# Copy to .env. These new names intentionally do not reuse the legacy bot's credentials.
BENTEBOT_DISCORD_TOKEN=
# Comma-separated numeric IDs. At least one guild or DM user must be enabled.
BENTEBOT_GUILD_IDS=
BENTEBOT_OWNER_IDS=
BENTEBOT_DM_USER_IDS=

# Existing LiteLLM gateway, with CLIProxyAPI optionally configured upstream there.
BENTEBOT_CHAT_BASE_URL=http://host.docker.internal:4000/v1
BENTEBOT_CHAT_API_KEY=
BENTEBOT_CHAT_MODEL=bentebot-chat
BENTEBOT_CHAT_MAX_TOKENS=2048
# Optional, provider/model-dependent. The tested qwen3.8-uncensored:fast alias accepts none.
# Blank preserves provider behavior. A nonblank value applies only to CHAT_MODEL unless
# CHAT_REASONING_MODELS explicitly lists comma-separated aliases; other models are unaffected.
BENTEBOT_CHAT_REASONING_EFFORT=
BENTEBOT_CHAT_REASONING_MODELS=
# Optional llama.cpp template control. List only aliases whose every upstream
# accepts chat_template_kwargs; keep blank for other providers.
BENTEBOT_CHAT_TEMPLATE_NO_THINKING_MODELS=
# Only list aliases whose EVERY LiteLLM upstream/fallback is local. Blank disables warming.
BENTEBOT_VOICE_WARM_MODELS=
# Immediate warm on /voice join, then one-token uncached requests during the call.
# Must be shorter than llama-swap's idle TTL on BOTH hosts. Stops on /voice leave.
BENTEBOT_VOICE_WARM_INTERVAL=120
BENTEBOT_VOICE_WARM_TIMEOUT=120
# Provider-active streaming time budget; slow playback does not consume this budget.
BENTEBOT_GENERATION_TIMEOUT=120
# Maximum wait for answer text in a voice generation after starting the request.
# Reasoning events do not count as answer text. HTTP connection/header timeouts are separate.
BENTEBOT_VOICE_FIRST_CONTENT_TIMEOUT=15
# Active voice history/retrieval budget, excluding persona and response instructions.
# Older messages remain stored and searchable. Text context keeps CONTEXT_CHARS.
# Set to 24000 to compare with the previous voice budget.
BENTEBOT_VOICE_CONTEXT_CHARS=8000

# Optional automatic read-only web research. Start the private SearXNG service separately.
# Only enable exact aliases that pass deploy/web-tools/qualify-model.py on EVERY upstream.
# Tool-enabled aliases currently buffer model rounds; ordinary aliases keep sentence streaming.
BENTEBOT_WEB_TOOLS_ENABLED=false
BENTEBOT_WEB_SEARCH_URL=
# Example: http://searxng:8080
BENTEBOT_WEB_TOOL_MODELS=
# Provider-native web search via the existing gateway's /v1/responses and /v1/messages.
# Exact aliases, disjoint from WEB_TOOL_MODELS. Provider support depends on your gateway;
# genuine Claude aliases were qualified on one gateway; qualify your own exact aliases.
# The four claude-* GPT compatibility duplicates are hidden in the bot, never inferred
# as Anthropic routes from their spelling. These lists NEVER enable model warming.
BENTEBOT_NATIVE_WEB_OPENAI_MODELS=
BENTEBOT_NATIVE_WEB_ANTHROPIC_MODELS=
# Helper CUDA arena budget, shared between sound (one quarter) and tone. Does not
# include every CUDA driver/library allocation. Add compose.cuda.yaml for GPU;
# omit that overlay for the optional CPU helper.
BENTEBOT_AUDIO_GPU_MEMORY_MB=1024
BENTEBOT_AUDIO_GPU_DEVICE=all
# Replace with the private LAN address of the host running the helper.
BENTEBOT_AUDIO_BIND_IP=127.0.0.1
BENTEBOT_WEB_TOOL_TIMEOUT=10
BENTEBOT_WEB_MAX_TOOL_ROUNDS=2

# Externally hosted WhisperLiveKit's Deepgram-compatible streaming endpoint.
# Leave blank for text-only operation. No STT model runs inside this bot.
BENTEBOT_STT_URL=
# Example: ws://speech-host:8765/v1/listen
BENTEBOT_STT_API_KEY=
BENTEBOT_STT_LANGUAGE=auto
# Name spelling hint for WhisperLiveKit. Blank disables; does not force a language.
BENTEBOT_STT_CONTEXT=Bentebot, Bente.

# External OpenAI-compatible TTS service. Must support response_format=wav.
BENTEBOT_TTS_BASE_URL=
# Example: http://speech-host:8766/v1
BENTEBOT_TTS_API_KEY=
BENTEBOT_TTS_MODEL=
BENTEBOT_TTS_VOICE=
# Optional comma-separated voice IDs for Discord autocomplete (no universal voices API exists).
BENTEBOT_TTS_VOICES=
# Warm local TTS silently on voice join; refresh while a voice session remains active.
BENTEBOT_TTS_WARM_ENABLED=true
BENTEBOT_TTS_WARM_INTERVAL=120
BENTEBOT_TTS_WARM_TIMEOUT=60
# Only enable with the official KittenTTS voice API. References persist there until deletion.
BENTEBOT_VOICE_PROFILES_ENABLED=false
# server = standing consent under your allowlisted server's rules; no per-clone button.
# individual = ask the selected speaker each time. Deletion is admin-only in both modes.
BENTEBOT_VOICE_CLONE_POLICY=server
# Actual target speech across pauses, not wall-clock audio. Requires a compatible cloning API.
BENTEBOT_VOICE_CLONE_SPEECH_SECONDS=45
# 14 minutes leaves time to report the result before Discord's interaction token expires.
BENTEBOT_VOICE_CLONE_WAIT_SECONDS=840
# No cloud audio by default. Opt-in is not proof of a free tier; enforce provider quotas.
BENTEBOT_ALLOW_CLOUD_AUDIO=false

BENTEBOT_INTERRUPTION_WORDS=5
# Disconnect after this many seconds without human listeners; other bots do not count.
BENTEBOT_VOICE_ALONE_TIMEOUT=60
BENTEBOT_TURN_SILENCE_MS=800
BENTEBOT_MAX_SPEAKERS=6
BENTEBOT_CONTEXT_CHARS=24000
BENTEBOT_RETENTION_DAYS=90
BENTEBOT_REQUEST_TIMEOUT=60
BENTEBOT_MAX_RESPONSE_CHARS=8000
BENTEBOT_MAX_TTS_CHARS=320
BENTEBOT_COLLECT_TEXT=true
# For a direct Python run; Compose overrides both values.
BENTEBOT_DATABASE_PATH=data/bentebot.sqlite3
BENTEBOT_HEALTH_PORT=8080

# Native Discord screen viewing uses the separately configured viewer service.
BENTEBOT_SCREEN_ENABLED=false
# Keep the failed bot-token Go Live probe disabled. Native viewing uses the dedicated viewer.
BENTEBOT_NATIVE_STREAM_PROBE_ENABLED=false
BENTEBOT_NATIVE_VIEWER_ENABLED=false
BENTEBOT_NATIVE_VIEWER_ID=0
BENTEBOT_NATIVE_VIEWER_KEY_FILE=
# Exact vision-capable alias exposed by your existing LiteLLM gateway.
BENTEBOT_VISION_MODEL=
# direct: relevant frames go to VISION_MODEL for the conversational reply (existing behavior).
# observer: VISION_MODEL extracts bounded visual evidence; CHAT_MODEL still generates the reply.
# Existing cloud alias example: gemma4:cloud. No continuous image inference in either mode.
BENTEBOT_VISION_MODE=direct
BENTEBOT_VISION_TIMEOUT=8
BENTEBOT_VISION_REQUESTS_PER_HOUR=60
# Published screen ingress origin, e.g. http://192.168.50.10:8768
BENTEBOT_SCREEN_BIND_IP=127.0.0.1
BENTEBOT_SCREEN_PUBLIC_URL=
BENTEBOT_SCREEN_FRAME_TTL=10

# Optional utility registry. Python is owner-only and uses fresh kernels.
BENTEBOT_UTILITY_TOOLS_ENABLED=false
BENTEBOT_JUPYTER_URL=http://jupyter-host:8888
BENTEBOT_JUPYTER_TOKEN=
BENTEBOT_JUPYTER_TIMEOUT=25

# Optional CPU/CUDA sound/tone and CPU Danish speech helper. See the README.
# Generate a private random token of at least 24 characters; use the same token for both services.
BENTEBOT_AUDIO_AWARENESS_ENABLED=false
BENTEBOT_AUDIO_REACTIONS_ENABLED=true
BENTEBOT_AUDIO_URL=http://audio-host:18769
BENTEBOT_AUDIO_TOKEN=
BENTEBOT_AUDIO_TIMEOUT=3
# Empty keeps current TTS unchanged; the helper returns 204 for English.
BENTEBOT_TTS_DANISH_BASE_URL=
